# Postgres connection string (e.g. from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (https://dashboard.clerk.com/~/api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# First sign-in with this email becomes Super Admin
SUPER_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TTI IDS API (server-side only)
TTI_API_KEY=
TTI_API_BASE=https://api.justrespond.com/api/v3
TTI_ACCOUNT_LOGIN=
TTI_LINK_LOGIN=

# Dev only: lets an admin "view as" another user from the nav. Leave unset on production.
ALLOW_IMPERSONATION=
